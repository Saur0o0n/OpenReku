(text "01  ESP32 I ODSPRZĘGANIE" (at 23 53 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "88f0d33d-c578-4951-a634-5a670319f0dc"))
(rectangle (start 150 20) (end 270 80) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "c111200d-228d-4bcc-a278-9ef70bcd277f"))
(text "02  ZASILANIE 5 V → 3,3 V" (at 153 23 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "f93b69d8-0cf5-4068-8fe6-08bf34102dc8"))
(rectangle (start 150 85) (end 270 139) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "bbc19e0c-c05d-44c6-8353-a107f6bc3e1e"))
(text "03  RESET I WYBÓR TRYBU STARTU" (at 153 88 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "b262bf1f-103c-41a6-84ce-063c91168e78"))
(rectangle (start 20 155) (end 145 194) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "8f349bfc-a908-4825-a49d-f677269844a5"))
(text "04  PROGRAMOWANIE UART" (at 23 158 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left top)) (uuid "d38102d2-5579-42e8-94ae-6716809678f1"))
(text "C3/C4: blisko pinów zasilania U1.\nGPIO2 i GPIO12: bez wymuszania stanu wysokiego przy starcie." (at 25 142 0) (effects (font (size 1 1)) (justify left top)) (uuid "1268da2d-ebde-4b94-8231-b61a4c900331"))
(text "C1/C2: blisko U2. C2: tantal, ESR 0,3–22 Ω.\nPad chłodzący U2 = +3V3. Zapewnić pole miedzi do chłodzenia.\n+5V z U6 (IRM-10-5), arkusz 230V." (at 155 68 0) (effects (font (size 1 1)) (justify left top)) (uuid "62379f90-474c-4e6e-aa1b-eecdf3b7f8de"))
(text "EN: R1 10k + C5 1µF.\nRESET zwiera EN do GND." (at 155 132 0) (effects (font (size 1 1)) (justify left top)) (uuid "6874d8bb-731c-4adb-afee-4dbd5d80241b"))
(text "BOOT zwiera GPIO0 do GND.\nR2 10k ustala normalny start." (at 212 132 0) (effects (font (size 1 1)) (justify left top)) (uuid "315332ac-7a42-4bc5-987d-30799f7956c3"))
(text "1 GND | 2 +3V3 | 3 RX ESP32 | 4 TX ESP32\nAdapter: TX → RX, RX → TX; logika 3,3 V.\nProgramowanie: trzymaj BOOT, naciśnij i puść RESET, puść BOOT.\nPrzy zasilaniu płytki z 5 V nie podłączaj zasilania 3,3 V adaptera." (at 25 180 0) (effects (font (size 1 1)) (justify left top)) (uuid "f208de49-8136-4f82-956d-996111ec04d6"))
